# Copie para .env na raiz do projeto (mesma pasta do docker-compose.yml) e ajuste os valores.
# NUNCA versione o .env.

# Banco de dados
DB_NAME=ai_db
DB_USER=labs
DB_PASSWORD=troque-esta-senha

# Chave de assinatura dos tokens JWT (mínimo 32 caracteres).
# Gere com: openssl rand -base64 48
JWT_SECRET=troque-por-uma-chave-aleatoria-de-no-minimo-32-caracteres

# Chave da OpenAI usada pelo chat e pelos embeddings
OPENAI_API_KEY=sk-...

# Origens exatas do navegador que podem chamar a API (protocolo + host + porta), separadas por vírgula.
# Se o site abre em http://2.25.108.222:3000, é exatamente isso que deve estar aqui.
FRONTEND_ORIGINS=http://2.25.108.222:3000,http://localhost:3000

# URL pública da API vista pelo navegador. Deixe vazio para usar http://<host-do-site>:8081.
VITE_LABS_API_URL=http://2.25.108.222:8081

# Swagger/OpenAPI aberto (mantenha false em produção)
LABS_DOCS_PUBLIC=false
